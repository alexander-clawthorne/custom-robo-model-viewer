; Custom Robo viewer vertex shader: transform, pass UVs, per-vertex
; Lambert lighting blended in by lighting.x (0 = unlit, 1 = lit).

; Uniforms
.fvec projection[4], modelView[4]
.fvec lightVec      ; view-space direction toward the light
.fvec lighting      ; x = lit, y = ambient, z = diffuse

; Constants
.constf myconst(0.0, 1.0, 0.00392156862, 0.0)
.alias  zeros  myconst.xxxx
.alias  ones   myconst.yyyy
.alias  inv255 myconst.zzzz

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outclr color

; Inputs
.alias inpos v0
.alias intex v1
.alias innrm v2
.alias inclr v3

.proc main
	; r1 = modelView * (inpos, 1)
	mov r0.xyz, inpos
	mov r0.w,   ones
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	; outpos = projection * r1
	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mov outtc0, intex

	; r1 = normalize(modelView * (innrm, 0))
	mov r0.xyz, innrm
	mov r0.w,   zeros
	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	mov r1.w, zeros
	dp3 r2, r1, r1
	rsq r2, r2
	mul r1, r2, r1

	; r3 = |n . l|: models are drawn double sided, so light both faces
	dp3 r3, lightVec, r1
	max r4, r3, -r3

	; shade = ambient + diffuse * ndotl, then 1 + lit * (shade - 1)
	mul r4, lighting.zzzz, r4
	add r4, lighting.yyyy, r4
	add r4, -ones, r4
	mul r4, lighting.xxxx, r4
	add r4, ones, r4

	; colour = vertex rgba / 255, rgb scaled by shade
	mul r5, inv255, inclr
	mul r5.xyz, r4.xyz, r5.xyz
	min outclr, ones, r5

	end
.end
